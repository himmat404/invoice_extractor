# Copy to backend/.env and adjust. All settings use the IF_ prefix (see app/core/config.py).
IF_ENVIRONMENT=development
IF_DATABASE_URL=postgresql+psycopg://invoiceflow:invoiceflow@localhost:5432/invoiceflow
IF_REDIS_URL=redis://localhost:6379/0
IF_CUSTOMER_APP_URL=http://localhost:5173
IF_ADMIN_APP_URL=http://localhost:5174
IF_CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]
IF_COOKIE_SECURE=false

# Email: console | smtp | memory  (Mailpit from docker compose listens on 1025, UI on :8025)
IF_EMAIL_DRIVER=smtp
IF_SMTP_HOST=localhost
IF_SMTP_PORT=1025
